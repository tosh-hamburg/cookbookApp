<?xml version="1.0" encoding="utf-8"?>
<!--
    Platzhalter ohne Foto: warme Fläche statt eines für alle Rezepte identischen Bildes.
    Das Symbol wird vom Adapter in der Sammlungsfarbe getönt.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/photo_placeholder" />
        </shape>
    </item>
    <item android:gravity="center" android:width="40dp" android:height="40dp"
        android:drawable="@drawable/ic_chef_hat" />
</layer-list>
