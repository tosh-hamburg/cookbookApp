<?xml version="1.0" encoding="utf-8"?>
<!-- Slot-Detail: Portionen, Rezept öffnen, entfernen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bottom_sheet_handle" />

    <TextView
        android:id="@+id/textSlotLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Cookbook.Label"
        tools:text="MONTAG · ABENDESSEN" />

    <TextView
        android:id="@+id/textSlotTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Cookbook.Serif"
        android:textSize="24sp"
        tools:text="Ofengemüse mit Feta" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/servings"
            android:textAppearance="@style/TextAppearance.Cookbook.Ui" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stepper_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnDecreaseServings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/decrease_servings"
                android:padding="12dp"
                android:src="@drawable/ic_minus"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/textServings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minWidth="40dp"
                android:textAppearance="@style/TextAppearance.Cookbook.Number.Stepper"
                tools:text="2" />

            <ImageButton
                android:id="@+id/btnIncreaseServings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/increase_servings"
                android:padding="12dp"
                android:src="@drawable/ic_plus"
                app:tint="@color/text_primary" />

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenRecipe"
        style="@style/Theme.Cookbook.Button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pill_height"
        android:layout_marginTop="20dp"
        android:text="@string/slot_open_recipe" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemoveSlot"
        style="@style/Theme.Cookbook.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pill_height"
        android:layout_marginTop="10dp"
        android:text="@string/slot_remove" />

</LinearLayout>
